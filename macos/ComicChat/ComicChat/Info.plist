<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Comic Chat</string>
	<!--
	  Live-fix 2 (Plan 4b, crypthome.com live-reproduced): a real avatar
	  announce on the wire ("# Appears as Belle'sBotTinkerBelle.http://www
	  .mermeliz.com/anneseeker/dl/Belle'sBotTinkerBelle.AVB") points at a
	  plain-HTTP URL -- App Transport Security blocked AvatarDownloader's
	  fetch outright. The 1998-era community avatar-art ecosystem this app
	  interoperates with (fan sites hosting .AVB/.BGB files) predates HTTPS
	  entirely and has no TLS-serving successor to migrate to; this is a
	  personal interop client for a legacy protocol, not an App Store
	  submission subject to ATS's App Store Review Guidelines carve-outs, so
	  a blanket exception (rather than a per-domain NSExceptionDomains list,
	  which would need updating for every new avatar-hosting site a user
	  encounters) is the correct scope here. AvatarDownloader (ComicChatKit)
	  runs its URLSession fetch in-process inside THIS app (the Kit has no
	  separate process of its own), so this app's Info.plist is the one that
	  governs the request -- there is no other ATS boundary to configure.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
